PORT=8000
DATABASE_URL=postgresql://postgres:parola_ta@localhost:5432/rrm_db
# Adresa frontend-ului care poate apela API-ul (mai multe, separate prin virgulă)
CORS_ORIGIN=http://localhost:5173
# DOAR pentru teste fără login (Postman, curl). Cu ALLOW_DEMO_AUTH=true,
# o cerere fără token folosește antetul X-User-Id sau DEMO_USER_ID (aici Ana
# Popescu, cercetător din datele de test). Implicit (false) login-ul e
# obligatoriu. Nu porniți niciodată opțiunea pe un server real.
ALLOW_DEMO_AUTH=false
DEMO_USER_ID=a0000000-0000-0000-0000-000000000003
# KAN-19: cheia secretă cu care se semnează token-urile de login. Puneți un
# text lung și aleatoriu, diferit pe fiecare calculator/server.
JWT_SECRET=schimba-ma-cu-un-text-lung-si-aleatoriu
# Cât e valabil un login (ex. 8h, 1d)
JWT_EXPIRES_IN=8h
# KAN-20: domeniile de email acceptate la „Creează cont” (separate prin
# virgulă; include și subdomeniile, ex. student.usv.ro). Gol = orice domeniu.
ALLOWED_EMAIL_DOMAINS=usv.ro
