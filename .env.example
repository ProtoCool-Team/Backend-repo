PORT=8000
DATABASE_URL=postgresql://postgres:parola_ta@localhost:5432/rrm_db
# Adresa frontend-ului care poate apela API-ul (mai multe, separate prin virgulă)
CORS_ORIGIN=http://localhost:5173
# DOAR pentru teste fără login (Postman, curl): utilizatorul folosit când
# cererea nu are token și nici antet X-User-Id (aici Ana Popescu, cercetător
# din datele de test). Lăsați gol ca login-ul să fie obligatoriu.
DEMO_USER_ID=a0000000-0000-0000-0000-000000000003
# KAN-19: cheia secretă cu care se semnează token-urile de login. Puneți un
# text lung și aleatoriu, diferit pe fiecare calculator/server.
JWT_SECRET=schimba-ma-cu-un-text-lung-si-aleatoriu
# Cât e valabil un login (ex. 8h, 1d)
JWT_EXPIRES_IN=8h
